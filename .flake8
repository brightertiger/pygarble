[flake8]
max-line-length = 79
extend-ignore = E203,W503
per-file-ignores =
    pygarble/data/words.py:E501
    pygarble/data/bigrams.py:E501
    pygarble/data/trigrams.py:E501
    pygarble/data/reference.py:E501
    pygarble/data/ngram_ranks.py:E501
    pygarble/data/calibration.py:E501
    paper/scripts/*.py:E402
    paper/regression/*.py:E402
